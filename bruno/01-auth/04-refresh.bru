meta {
  name: Refresh Access Token
  type: http
  seq: 4
  tags: [
    foundation
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.accessToken) {
    bru.setEnvVar("accessToken", body.accessToken);
    bru.setEnvVar("refreshToken", body.refreshToken);
  }
}

tests {
  test("rotates the refresh token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("accessToken");
    expect(res.getBody()).to.have.property("refreshToken");
  });
}
