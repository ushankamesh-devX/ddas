meta {
  name: Civilian Login
  type: http
  seq: 2
  tags: [
    foundation
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "email": "{{civilianEmail}}",
  "password": "{{civilianPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.accessToken) {
    bru.setEnvVar("civilianToken", body.accessToken);
  }
}

tests {
  test("civilian can login", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("accessToken");
  });
}
