meta {
  name: Current User
  type: http
  seq: 3
  tags: [
    foundation
  ]
}

get {
  url: {{baseUrl}}/api/v1/auth/me
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("returns the authenticated identity", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().email).to.equal("admin@example.test");
    expect(res.getBody().roles).to.include("SUPER_ADMIN");
  });
}
