meta {
  name: Alert-zone same-dam contract
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/alerts
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Idempotency-Key: cross-domain-zone-contract
}

body {
{
  "severity": "WARNING",
  "title": "Cross-domain isolation",
  "message": "Should fail",
  "riskZoneIds": [
    "{{otherDamZoneId}}"
  ]
}
}

tests {
  test("alert cannot cross dam boundary", function () {
    expect([400,403,404,409]).to.include(res.getStatus());
  });
}
