meta {
  name: Civilian cannot review report
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/reports/{{reportId}}/review
  body: json
}

headers {
  Authorization: Bearer {{civilianToken}}
  Content-Type: application/json
}

body:json {
  {
  "decision": "VERIFIED",
  "note": "No"
  }
}

tests {
  test("status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
