meta {
  name: Civilian cannot create alert
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/alerts
}

headers {
  Authorization: Bearer {{civilianToken}}
  Content-Type: application/json
  Idempotency-Key: civilian-alert-denied
}

body {
{
  "severity": "WARNING",
  "title": "Unauthorized",
  "message": "No",
  "riskZoneIds": [
    "{{zoneId}}"
  ]
}
}

tests {
  test("status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
