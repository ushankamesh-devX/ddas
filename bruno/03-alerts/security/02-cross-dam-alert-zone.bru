meta {
  name: Alert cannot target other dam zone
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/alerts
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Idempotency-Key: cross-dam-zone
}

body:json {
  {
  "severity": "WARNING",
  "title": "Cross dam",
  "message": "No",
  "riskZoneIds": [
    "{{otherDamZoneId}}"
  ]
  }
}

tests {
  test("cross-dam target rejected", function () {
    expect([400,403,404,409]).to.include(res.getStatus());
  });
}
