meta {
  name: Alert idempotency duplicate
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/alerts
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Idempotency-Key: bruno-idempotent-alert-001
}

body:json {
  {
  "severity": "WARNING",
  "title": "Idempotent warning",
  "message": "Same request",
  "riskZoneIds": [
    "{{zoneId}}"
  ]
  }
}

tests {
  test("duplicate request is not a second logical alert", function () {
    expect([200,201]).to.include(res.getStatus());
  });
}
