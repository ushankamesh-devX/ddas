meta {
  name: Alert - missing title
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/alerts
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
  Idempotency-Key: negative-missing-title
}

body:json {
  {
  "severity": "WARNING",
  "message": "Test",
  "riskZoneIds": [
    "{{zoneId}}"
  ]
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
