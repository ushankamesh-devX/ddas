meta {
  name: Create IoT Device
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/iot-devices
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body {
{
  "name": "Spillway Gateway 01",
  "deviceType": "GATEWAY",
  "authMethod": "DEVICE_KEY"
}
}

tests {
  test("device created and one-time key returned", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body.credentials).to.have.property("deviceKey");
    expect(body.credentials.shownOnce).to.equal(true);
  });
  const body = res.getBody();
  if (body && body.id) bru.setEnvVar("iotDeviceId", body.id);
}
