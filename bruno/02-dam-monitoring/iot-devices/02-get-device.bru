meta {
  name: Get IoT Device
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/iot-devices/{{iotDeviceId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("GET never exposes plaintext device key", function () {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).to.not.include("deviceKey");
  });
}
