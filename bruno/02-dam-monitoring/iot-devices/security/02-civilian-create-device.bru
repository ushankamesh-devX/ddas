meta {
  name: Civilian cannot create IoT device
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/iot-devices
}

headers {
  Authorization: Bearer {{civilianToken}}
  Content-Type: application/json
}

body {
{
  "name": "Bad Device",
  "deviceType": "GATEWAY",
  "authMethod": "DEVICE_KEY"
}
}

tests {
  test("status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
