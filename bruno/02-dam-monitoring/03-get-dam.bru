meta {
  name: Get Dam
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/dams/{{damId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("returns success", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getEnvVar("damId"));
  });
}
