meta {
  name: Operator sees only assigned dam
  type: http
  seq: 0
  tags: [
    foundation
  ]
}

get {
  url: {{baseUrl}}/api/v1/dams
}

headers {
  Authorization: Bearer {{operatorToken}}
}

tests {
  test("operator sees only Dam A", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array").with.lengthOf(1);
    expect(res.getBody()[0].id).to.equal("00000000-0000-0000-0000-000000000001");
  });
}
