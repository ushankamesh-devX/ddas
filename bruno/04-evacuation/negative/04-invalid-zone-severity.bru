meta {
  name: Zone - invalid severity
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/dams/{{damId}}/risk-zones
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
  "code": "BAD-SEVERITY",
  "name": "Invalid Severity Zone",
  "severity": "APOCALYPTIC",
  "evacuationRequired": true,
  "publicVisible": true,
  "geometry": {
    "type": "Polygon",
    "coordinates": [
      [
        [
          80.12,
          7.12
        ],
        [
          80.13,
          7.12
        ],
        [
          80.13,
          7.13
        ],
        [
          80.12,
          7.13
        ],
        [
          80.12,
          7.12
        ]
      ]
    ]
  }
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
