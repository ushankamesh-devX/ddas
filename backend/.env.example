# Local backend only. Do not reuse these credentials elsewhere.
SPRING_PROFILES_ACTIVE=local

# Application security (local development values only; replace outside local use).
JWT_SECRET=local-only-signing-secret-change-before-deployment-32chars
JWT_ISSUER=dam-alert-backend
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Deterministic local users use this password. Fixtures are never enabled by default.
APP_FIXTURES_ENABLED=true
APP_FIXTURE_PASSWORD=ChangeMe123!

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/dam_alert
DB_USERNAME=damapp
DB_PASSWORD=damapp_dev

# Empty credentials are intentional: local Mosquitto allows anonymous clients.
MQTT_BROKER_URI=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MinIO/S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev_only
MINIO_BUCKET=dam-alert-reports
